  "screenshots": [
    {
      "src": "screenshots/dashboard-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Dashboard view showing vessel overview and quick stats"
    },
    {
      "src": "screenshots/vessels-narrow.png",
      "sizes": "360x640",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Vessel management on mobile device"
    }
  ],
  
  "categories": ["business", "productivity", "utilities"],
  "keywords": ["vessel", "ship", "marine", "engine", "logging", "maritime", "fleet"],
  
  "prefer_related_applications": false,
  
  "shortcuts": [
    {
      "name": "Add Log Entry",
      "short_name": "Add Log",
      "description": "Quickly add a new engine log entry",
      "url": "/vessels.php?action=add_log",
      "icons": [
        {
          "src": "icons/shortcut-add-log.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "View Vessels",
      "short_name": "Vessels",
      "description": "View and manage your vessel fleet",
      "url": "/vessels.php",
      "icons": [
        {
          "src": "icons/shortcut-vessels.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Sync Data",
      "short_name": "Sync",
      "description": "Synchronize offline changes with server",
      "url": "/dashboard.php?action=sync",
      "icons": [
        {
          "src": "icons/shortcut-sync.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  
  "related_applications": [],
  
  "edge_side_panel": {
    "preferred_width": 400
  },
  
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  
  "protocol_handlers": [
    {
      "protocol": "web+vessellog",
      "url": "/vessels.php?vessel=%s"
    }
  ],
  
  "file_handlers": [
    {
      "action": "/import",
      "accept": {
        "application/json": [".json"],
        "text/csv": [".csv"],
        "application/vnd.ms-excel": [".xls", ".xlsx"]
      },
      "icons": [
        {
          "src": "icons/file-handler.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ]
}
